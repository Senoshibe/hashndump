    #!/usr/bin/env zsh

    checkForPython() {
        if [[ -x /Library/Developer/CommandLineTools/usr/bin/python3 ]]; then
            return 0
        #Check if python3 path exists, and if it exists, function succeeds
        else 
            echo 'Install Python For hashndump tool to work! Install Python and Try Again!'
            sleep 3
            xcode-select --install
            return 1
        #force install of macOS 'CommandLineTools' which includes Python. Fail function to halt script.
        fi
    }

    cd 'Digital Forensic Evidence/MangoBleed' || exit 1
    #get into the digital forensic evidence directory

    if [[ -f hashcheck.txt ]]; then
        exit 1
    #checks if there's already a txt file with source evidence and corresponding hash. If there is, exit.
    fi
    checkForPython || exit 1
    #make sure analyst's device has python in order to run the utmp.py tool.

    mkdir collected
    cp -p auth.log wtmp collected/
    #Keep integrity of evidence while making copies in a separate folder 'collected' i.e. evidence collected.

    shasum -a 256 ./auth.log ./wtmp > hashcheck.txt

    grep -inE 'Failed password|Invalid user|Accepted password|useradd|groupadd|COMMAND=' ./collected/auth.log > findings.txt
    #grep key words in auth.logs and put it in text file for examination later.

    python3 ../../utmp.py -o collected/wtmp.out collected/wtmp
    #parse wtmp binary file to be more human readable.

    echo "Done. Read findings.txt and Search Suspicious IPv4 Address in collected/wtmp.out. Check hash for any tampering."